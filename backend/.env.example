NODE_ENV=development
PORT=5000

# MongoDB Atlas - Replace with your actual connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vaidyasetu?retryWrites=true&w=majority

# Google OAuth 2.0 - For patient authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secret - Change this to a random secure string
JWT_SECRET=your-super-secret-jwt-key-change-in-production-use-random-string
JWT_EXPIRES_IN=7d

# Doctor Configuration
DOCTOR_EMAIL=sujal.jadhav@example.com
DOCTOR_ID=dr_sujal_jadhav_001
DOCTOR_USERNAME=dr.sujal
# Run: node -e "console.log(require('bcryptjs').hashSync('your_password', 10))" to generate
DOCTOR_PASSWORD_HASH=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png

# WebSocket
SOCKET_PORT=5001
